{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "icon": "assets/kung/icon.png",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "https://github.com/bnc-schmidt",
    "sources": "https://github.com/bnc-schmidt/kung"
  },
  "license": "${mod_license}",
  "environment": "client",
  "mixins": [
    "kung.mixins.json"
  ],
  "entrypoints": {
    "main": [
      "com.github.beng420.kung.KungMod"
    ],
    "client": [
      "com.github.beng420.kung.KungClient"
    ],
    "modmenu": [
      "com.github.beng420.kung.compat.KungModMenu"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  }
}
