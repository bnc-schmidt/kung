# Becomes kung-server.env in the install folder (root, mode 600).
KUNG_ROOM_SYNC_PORT=8765
# 0.0.0.0 = LAN. Set 127.0.0.1 once the Cloudflare Tunnel runs.
KUNG_ROOM_SYNC_HOST=0.0.0.0
# install.sh sets this to <install folder>/data/known-rooms.json on every run.
KUNG_ROOM_DATA_PATH=data/known-rooms.json
KUNG_LIVE_ROOM_SYNC_TTL_MS=180000

# Players sign in through Mojang; every verified Minecraft account may sign in and read.
# This list only gates room uploads (POST /rooms/report): comma-separated Minecraft UUIDs,
# dashes optional. Empty = nobody can upload. Line removed (unset): KUNG_ALLOWED_UUIDS is used.
KUNG_ROOM_WRITER_UUIDS=
KUNG_SESSION_TTL_MS=43200000
KUNG_AUTH_LIMIT_PER_5_MIN=20

# Hypixel API proxy for the CA50 calculator. Empty = proxy off.
HYPIXEL_API_KEY=
KUNG_PROFILE_CACHE_MS=120000
KUNG_PROFILE_LIMIT_PER_5_MIN=30

# Per signed-in player, per 5 minutes. 429 over the limit.
KUNG_PROFILE_USER_LIMIT_PER_5_MIN=30
KUNG_LIVE_REPORT_LIMIT_PER_5_MIN=1800
KUNG_ROOM_REPORT_LIMIT_PER_5_MIN=30
